<%= form_with model: [:admin, ad], multipart: true, class: "form" do |f| %>
  <% if ad.errors.any? %>
    <div class="errors">
      <strong>Please fix:</strong>
      <ul>
        <% ad.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card">
    <h2>Ad</h2>
    <div class="grid">
      <label class="span2">Name
        <%= f.text_field :name, required: true, placeholder: "Sideby" %>
        <small>Internal name, also used as alt text if none is set.</small>
      </label>

      <label class="span2">Target URL
        <%= f.url_field :target_url, required: true, placeholder: "https://play.google.com/store/apps/details?id=..." %>
        <small>Your app's store page, your website, or an affiliate link.</small>
      </label>

      <label>Weight (1 to 100)
        <%= f.number_field :weight, min: 1, max: 100, step: 1 %>
        <small>Higher weight = shown more often.</small>
      </label>

      <label>Label
        <%= f.text_field :label, maxlength: 30 %>
        <small>"Publicité" or "Lien affilié" (required by French law).</small>
      </label>

      <label>Starts at
        <%= f.datetime_local_field :starts_at %>
        <small>Optional.</small>
      </label>

      <label>Ends at
        <%= f.datetime_local_field :ends_at %>
        <small>Optional.</small>
      </label>

      <label>Only show in
        <%= f.text_field :app_keys_list, placeholder: "fidele, sideby, portfolio" %>
        <small>App keys, comma separated. Empty = everywhere.</small>
      </label>

      <label>Hide in
        <%= f.text_field :target_app_key, placeholder: "sideby" %>
        <small>If this ad promotes one of your apps, put its key to hide it inside that app.</small>
      </label>

      <label class="span2">Alt text
        <%= f.text_field :alt_text, placeholder: "Accessibility description" %>
      </label>

      <label class="check span2">
        <%= f.check_box :active %> Active
      </label>
    </div>
  </section>

  <section class="card">
    <h2>Placements</h2>
    <p class="muted small">Tick each format this ad should appear in and upload its image. Unticked formats are never returned by the API.</p>

    <div class="placements">
      <% Ad::PLACEMENTS.each do |placement| %>
        <% image = ad.image_for(placement) %>
        <div class="placement-box">
          <label class="check">
            <%= f.check_box :"#{placement}_enabled" %>
            <strong><%= placement.capitalize %></strong>
            <span class="muted small"><%= Ad::SUGGESTED_SIZE[placement] %></span>
          </label>
          <% if image.attached? && image.persisted? %>
            <div class="current-image <%= placement %>"><%= ad_thumb(ad, "preview-img", placement: placement) %></div>
          <% end %>
          <%= f.file_field :"#{placement}_image", accept: Ad::IMAGE_TYPES.join(",") %>
          <small class="muted"><%= image.attached? ? "Upload a new file to replace it." : "PNG, JPEG, WebP or GIF, max 2 MB." %></small>
        </div>
      <% end %>
    </div>
  </section>

  <div class="form-actions">
    <%= f.submit ad.new_record? ? "Create ad" : "Save changes", class: "btn" %>
    <%= link_to "Cancel", ad.persisted? ? admin_ad_path(ad) : admin_ads_path, class: "btn ghost" %>
  </div>
<% end %>
